# Home Assistant Configuration
# Leave both empty to run in demo mode with fictional data.
#
# The URL of your Home Assistant instance (e.g., http://192.168.1.100:8123)
HOME_ASSISTANT_URL=

# A Long-Lived Access Token generated from your Home Assistant profile
# (Profile → Security → Long-lived access tokens)
HOME_ASSISTANT_TOKEN=

# Set to 'true' to force demo data even when the two values above are set.
# These credentials stay on the server; they are never sent to the browser.
NEXT_PUBLIC_USE_MOCK=
